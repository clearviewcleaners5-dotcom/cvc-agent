# CVC Content Agent — Environment Variables
# Add ALL of these to your Vercel project under Settings > Environment Variables
# Never commit this file to GitHub with real values filled in

ANTHROPIC_API_KEY=your_claude_api_key_here
DROPBOX_ACCESS_TOKEN=your_dropbox_access_token_here
META_PAGE_ACCESS_TOKEN=your_facebook_page_access_token_here
META_PAGE_ID=your_facebook_page_id_here
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id_here
